+    // unsigned (logical) right shift to avoid turning user pointers into
+    // kernel addresses.
+#if defined(__aarch64__) || defined(_M_ARM64)
+    auto extended = raw >> kInternalStampBits;
+    return reinterpret_cast<T*>(static_cast<uintptr_t>(extended));
+#else
     auto extended = static_cast<int64_t>(raw) >> kInternalStampBits;
     return reinterpret_cast<T*>(static_cast<intptr_t>(extended));
+#endif
   }
 
